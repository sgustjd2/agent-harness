{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/agent-harness/schemas/proposal.schema.json",
  "title": "agent-harness refinement proposal (.agent-harness/proposals/<proposal-id>.md frontmatter)",
  "description": "PRD FR-014, FR-015, §16. Local-only by default (DEC-C22). Every item needs evidence.",
  "type": "object",
  "required": ["schema_version", "proposal_id", "created", "status", "source_runs", "items"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "proposal_id": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{6}-[a-z0-9]+(-[a-z0-9]+)*$" },
    "created": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["proposed", "approved", "rejected", "applied", "failed", "reverted"],
      "description": "PRD §16.3. Exactly these six values."
    },
    "source_runs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{6}-[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "applied_at": { "type": ["string", "null"] },
    "rollback": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "vcs": { "type": "string", "enum": ["git", "backup"] },
        "git_head": { "type": ["string", "null"] },
        "backup_dir": { "type": ["string", "null"] }
      },
      "description": "FR-016. Recorded before any write."
    },
    "rejected_reason": { "type": ["string", "null"] },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["item_id", "change_type", "target_path", "proposed", "evidence_refs", "risk"],
      "additionalProperties": false,
      "properties": {
        "item_id": { "type": "string", "pattern": "^I-[0-9]{3}$" },
        "change_type": {
          "type": "string",
          "enum": ["fact", "decision", "pattern", "config", "role", "workflow", "skill"],
          "description": "PRD §16.4. 'skill' is Deferred -- never auto-applied (DEC-P11)."
        },
        "target_path": { "type": "string", "minLength": 1 },
        "current": { "type": ["string", "null"] },
        "current_hash": {
          "type": ["string", "null"],
          "description": "SEC-20: binds approval to the file state seen at proposal time. Mismatch = stale."
        },
        "proposed": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "FR-014 AC-2: an item with no evidence must not be created."
        },
        "risk": { "type": "string", "enum": ["low", "medium", "high"] },
        "conflict": { "type": "boolean" }
      }
    }
  }
}
