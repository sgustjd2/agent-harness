{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/agent-harness/schemas/evidence.schema.json",
  "title": "agent-harness run evidence (.agent-harness/runs/<run-id>/evidence.md frontmatter)",
  "description": "PRD FR-011, §14.1. Append-only. Local-only by default (DEC-C22).",
  "type": "object",
  "required": ["schema_version", "run_id", "host", "orchestration_mode", "items"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{6}-[a-z0-9]+(-[a-z0-9]+)*$" },
    "host": {
      "type": "string",
      "enum": ["claude-code", "codex", "unknown"],
      "description": "FR-004 host capability detection."
    },
    "orchestration_mode": {
      "type": "string",
      "enum": ["direct", "sequential", "parallel"],
      "description": "FR-008 / FR-009."
    },
    "degraded_reason": {
      "type": ["string", "null"],
      "description": "PRD §13.11. Non-empty whenever orchestration was downgraded (FR-009 AC-2)."
    },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["evidence_id", "timestamp", "type"],
      "additionalProperties": false,
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^E-[0-9]{3}$" },
        "timestamp": { "type": "string", "minLength": 1 },
        "task_id": { "type": ["string", "null"], "pattern": "^T-[0-9]{3}$" },
        "role": {
          "type": ["string", "null"],
          "enum": ["coordinator", "researcher", "implementer", "reviewer", "tester", "refiner", null]
        },
        "type": { "type": "string", "enum": ["delegation", "command", "gate", "note"] },
        "gate_id": { "type": ["string", "null"] },
        "command": {
          "type": "array",
          "items": { "type": "string" },
          "description": "argv array, redacted before storage (FR-023)."
        },
        "exit_code": { "type": ["integer", "null"] },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "classification": { "$ref": "#/$defs/classification" },
        "output_excerpt": {
          "type": ["string", "null"],
          "maxLength": 65536,
          "description": "PRD §14.6: head 200 + tail 200 lines, 64 KiB cap, redaction applied."
        },
        "artifacts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "classification": {
      "type": ["string", "null"],
      "enum": ["pass", "fail", "error", "timeout", "skipped", "flaky", null],
      "description": "PRD §15.4. 'flaky' is never treated as 'pass'."
    }
  }
}
